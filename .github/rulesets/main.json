{
  "name": "protect main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "bypass_actions": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "branch name" },
          { "context": "lint" },
          { "context": "test (windows-latest, py3.12)" },
          { "context": "test (windows-latest, py3.13)" },
          { "context": "test (windows-latest, py3.14)" },
          { "context": "test (ubuntu-latest, py3.12)" },
          { "context": "test (ubuntu-latest, py3.13)" },
          { "context": "test (ubuntu-latest, py3.14)" },
          { "context": "installer (windows-latest)" },
          { "context": "installer (ubuntu-latest)" }
        ]
      }
    }
  ]
}
